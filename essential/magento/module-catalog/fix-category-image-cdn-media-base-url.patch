+    /**
+     * Resolve a file URL to a path relative to the media directory.
+     *
+     * Handles both URLs served from the store's own domain (e.g. /media/wysiwyg/image.jpg) and URLs served
+     * from a separate, absolute media base URL such as a CDN (e.g. https://cdn.example.com/wysiwyg/image.jpg),
+     * which do not necessarily contain the local media directory name in their path.
+     *
+     * @param string $url
+     * @return string|null
+     */
+    private function getPathRelativeToMediaDirectory($url)
+    {
+        $mediaBaseUrl = $this->getMediaBaseUrl();
+
+        if ($mediaBaseUrl !== null && strpos($url, $mediaBaseUrl) === 0) {
+            return ltrim(substr($url, strlen($mediaBaseUrl)), '/');
+        }
+
+        // phpcs:ignore Magento2.Functions.DiscouragedFunction
+        $fileUrl = ltrim((string) parse_url($url, PHP_URL_PATH), '/');
+        $baseMediaDir = ltrim((string) $this->_filesystem->getUri(DirectoryList::MEDIA), '/');
+
+        if (!$baseMediaDir || strpos($fileUrl, $baseMediaDir . '/') !== 0) {
+            return null;
+        }
+
+        return substr($fileUrl, strlen($baseMediaDir) + 1);
+    }
+
+    /**
+     * Get the store's configured base URL for media files, without a trailing slash.
+     *
+     * @return string|null
+     */
+    private function getMediaBaseUrl()
+    {
+        try {
+            $mediaBaseUrl = rtrim($this->storeManager->getStore()->getBaseUrl(UrlInterface::URL_TYPE_MEDIA), '/');
+        } catch (NoSuchEntityException $exception) {
+            return null;
+        }
+
+        return $mediaBaseUrl ?: null;
     }

