--- a/Block/Adminhtml/Catalog/Attribute/Translation.php
+++ b/Block/Adminhtml/Catalog/Attribute/Translation.php
@@ -86,7 +86,10 @@ class Translation extends Container
 
             foreach ($stores as $storeKey => $singleStore) {
                 $storeOptions[$storeKey] = [
-                    'label' => __($singleStore->getName() . ' - ' . $this->_translatorHelper->getLanguageByStoreId($singleStore)),
+                    // BEGIN PATCH
+                    // 'label' => __($singleStore->getName() . ' - ' . $this->_translatorHelper->getLanguageByStoreId($singleStore)),
+                    'label' => __($singleStore->getWebsite()->getName() . ' / ' . $singleStore->getName() . ' - ' . $this->_translatorHelper->getLanguageByStoreId($singleStore)),
+                    // END PATCH
                     'onclick' => 'selectSourceStore(\'' . __(
                         'Please select source store.'
                     ) . '\', \'' . $this->getActionUrl($singleStore) . '\', \'' . $sourceStoreId . '\')',
