+    // BEGIN PATCH
+    /**
+     * Drop a phpredis pipeline whose commands could not all be queued, so the shared connection is not left in PIPELINE mode
+     *
+     * @param \Redis|object $pipeline
+     * @return void
+     */
+    private function discardPipeline($pipeline): void
+    {
+        if ($pipeline instanceof \Redis) {
+            $pipeline->discard();
+        }
+    }
+
+    /**
+     * Bring a phpredis connection left in PIPELINE/MULTI mode back to ATOMIC mode
+     *
+     * @return void
+     */
+    private function ensureAtomicMode(): void
+    {
+        if ($this->redis instanceof \Redis && $this->redis->getMode() !== \Redis::ATOMIC) {
+            $this->redis->discard();
+        }
+    }
+
+    /**
+     * Re-open the phpredis connection in place after its replies went out of sync with its commands
+     *
+     * @return void
+     */
+    private function reconnect(): void
+    {
+        if (!$this->redis instanceof \Redis) {
+            return;
+        }
+
+        $redis = $this->redis;
+        $host = (string)$redis->getHost();
+        $port = (int)$redis->getPort();
+        $timeout = (float)$redis->getTimeout();
+        $readTimeout = (float)$redis->getReadTimeout();
+        $persistentId = $redis->getPersistentID();
+        $auth = $redis->getAuth();
+        $database = (int)$redis->getDBNum();
+
+        $this->ensureAtomicMode();
+        $redis->close();
+
+        if (is_string($persistentId) && $persistentId !== '') {
+            $redis->pconnect($host, $port, $timeout, $persistentId, 0, $readTimeout);
+        } else {
+            $redis->connect($host, $port, $timeout, null, 0, $readTimeout);
+        }
+
+        if (!empty($auth)) {
+            $redis->auth($auth);
+        }
+
+        $redis->select($database);
+    }
+
+    /**
+     * @param array $values
+     * @return bool
+     */
+    private function isListOfStrings(array $values): bool
+    {
+        return count(array_filter($values, 'is_string')) === count($values);
+    }
