+    // BEGIN PATCH
+    private function isPartialShippingRefund(CoreRefund $refund, CoreLineItem $refundedShippingItem): bool
+    {
+        if ($refund->reducedLineItems === null) {
+            return false;
+        }
+
+        $baseUniqueId = strstr((string) $refundedShippingItem->uniqueId, '__', true) ?: $refundedShippingItem->uniqueId;
+        foreach ($refund->reducedLineItems as $reducedLineItem) {
+            if ($reducedLineItem->type === CoreLineItem::TYPE_SHIPPING && $reducedLineItem->uniqueId === $baseUniqueId && $reducedLineItem->quantity > 0 && $reducedLineItem->amountIncludingTax > 0) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    private function getAmountToCredit(CoreRefund $refund, Order $order): float
+    {
+        $orderCurrency = (string) $order->getOrderCurrencyCode();
+        $refundAmount = (float) $this->helper->roundAmount((float) $refund->amount, $orderCurrency);
+        $totalToRefund = (float) $this->helper->roundAmount((float) $order->getGrandTotal() - (float) $order->getTotalRefunded(), $orderCurrency);
+
+        if (CurrencyRoundingService::areAmountsEqual($refundAmount + 0.01, $totalToRefund, $orderCurrency)) {
+            return $totalToRefund;
+        }
+
+        return $refundAmount;
+    }
+    // END PATCH
