+        if ($refund->reducedLineItems === null) {
+            return false;
+        }
+
+        $baseUniqueId = strstr((string) $refundedShippingItem->uniqueId, '__', true) ?: $refundedShippingItem->uniqueId;
+        foreach ($refund->reducedLineItems as $reducedLineItem) {
+            if ($reducedLineItem->type === CoreLineItem::TYPE_SHIPPING && $reducedLineItem->uniqueId === $baseUniqueId && $reducedLineItem->quantity > 0 && $reducedLineItem->amountIncludingTax > 0) {
