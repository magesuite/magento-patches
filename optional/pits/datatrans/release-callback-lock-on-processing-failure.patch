-                $result = $this->processResponseCallback($transactionId, $urlType, $params);
+                //BEGIN PATCH
+//                $result = $this->processResponseCallback($transactionId, $urlType, $params);
+                try {
+                    $result = $this->processResponseCallback($transactionId, $urlType, $params);
+                } catch (\Throwable $processingException) {
+                    $this->releaseResponseCallback($refId);
+                    throw $processingException;
+                }
+                //END PATCH
                 $data = $this->transactionUrlFactory->create()->setId($refId)
                     ->setStatus($result['status'] ?? 'NA')
